#!/usr/bin/env bash
set -euo pipefail

# CloudRedirect Native Installer (cloudredirect-moon)
# Part of Enter The Wired project
#
# Deploys the vendored 32-bit cloud_redirect.so, enables Steam Cloud in the
# SLSsteam config, patches steam.sh with the CloudRedirect loader and builds
# the native Qt6 GUI (.desktop entry). All assets live in vendor/ of this
# repository - no external hosts are required (the repo tarball is the only
# fallback when this script runs without its vendor/ directory).

REPO_TARBALL_URL="https://codeload.github.com/LucianoSkx/enter-the-wired/tar.gz/refs/heads/main"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ASSETS=""

XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_APPS_DIR="$XDG_DATA_HOME/applications"
ICONS_DIR="$XDG_DATA_HOME/icons/hicolor"

CR_DATA="$XDG_DATA_HOME/CloudRedirect"
CR_STAGE="$XDG_DATA_HOME/cloud_redirect"
CR_UI="$CR_DATA/cloud-redirect-ui"
CR_STAMP="$CR_DATA/.ui-build-stamp"

FLATPAK_STEAM_DIR="$HOME/.var/app/com.valvesoftware.Steam/.steam/steam"
FLATPAK_SLS_DIR="$HOME/.var/app/com.valvesoftware.Steam/.local/share/SLSsteam"
FLATPAK_CR_DATA="$HOME/.var/app/com.valvesoftware.Steam/.local/share/CloudRedirect"
FLATPAK_SLS_CONFIG_DIR="$HOME/.var/app/com.valvesoftware.Steam/.config/SLSsteam"

BUILD_UI=true
FORCE_REBUILD=false

# Colors (disabled if not a fully interactive terminal)
if [ -t 1 ] && [ -t 0 ]; then
    GREEN='\033[0;32m'
    RED='\033[0;31m'
    YELLOW='\033[1;33m'
    NC='\033[0m'
else
    GREEN=''
    RED=''
    YELLOW=''
    NC=''
fi

die() {
    echo -e "${RED}Error: $*${NC}" >&2
    exit 1
}

download_file() {
    local url="$1"
    local dest="$2"
    local max_time="${3:-120}"
    local curl_flags=(-fL --retry 3 --retry-delay 2 --retry-connrefused --connect-timeout 20 --max-time "$max_time" -o "$dest")

    if [ -t 1 ] && [ "$max_time" -ge 300 ]; then
        curl_flags+=(--progress-bar)
    else
        curl_flags+=(-sS)
    fi

    curl "${curl_flags[@]}" "$url"
}

usage() {
    cat <<EOF
Usage: cloudredirect [options]

Installs CloudRedirect (cloudredirect-moon) natively: .so, steam.sh loader
and the Qt6 GUI with a .desktop launcher.

Options:
  --no-ui     Skip building the native GUI (only .so + config)
  --rebuild   Force rebuilding the GUI even if it is up to date
  -h, --help  Show this help
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --no-ui) BUILD_UI=false ;;
        --rebuild) FORCE_REBUILD=true ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option: $1 (use --help)" ;;
    esac
    shift
done

CLEANUP_DIRS=()
cleanup_all() {
    local d
    for d in ${CLEANUP_DIRS[@]+"${CLEANUP_DIRS[@]}"}; do
        if [ -n "$d" ] && [ -d "$d" ]; then
            rm -rf "$d"
        fi
    done
}
trap cleanup_all EXIT

# Assets are vendored in vendor/cloudredirect of this repository. When the
# script is executed without that directory (curl | bash), fetch the repo
# tarball once and use the vendored copy from it.
resolve_assets_dir() {
    local candidate tmp tarball inner

    for candidate in \
        "$SELF_DIR/vendor/cloudredirect" \
        "$HOME/enter-the-wired/vendor/cloudredirect"; do
        if [ -f "$candidate/cloud_redirect.so" ] && [ -d "$candidate/ui-linux" ]; then
            ASSETS="$candidate"
            echo "Assets: $ASSETS"
            return 0
        fi
    done

    echo "Local vendor/ not found - fetching assets from the repository tarball..."
    tmp="$(mktemp -d)"
    CLEANUP_DIRS+=("$tmp")
    tarball="$tmp/repo.tar.gz"
    download_file "$REPO_TARBALL_URL" "$tarball" 300 \
        || die "could not download the repository tarball ($REPO_TARBALL_URL)"
    tar -xzf "$tarball" -C "$tmp" \
        || die "could not extract the repository tarball"

    inner="$tmp/enter-the-wired-main"
    if [ ! -f "$inner/vendor/cloudredirect/cloud_redirect.so" ]; then
        die "vendor/cloudredirect is missing from the repository tarball"
    fi
    ASSETS="$inner/vendor/cloudredirect"
    echo "Assets: $ASSETS (from repository tarball)"
}

detect_distro_family() {
    local ID="" ID_LIKE=""
    if [ -f /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
    fi

    if [[ "${ID:-}" == "steamos" ]] || [[ "${ID_LIKE:-}" =~ steamos ]]; then
        echo "arch"
    elif [[ "${ID:-}" == "bazzite" || "${ID:-}" == "fedora" || "${ID:-}" == "rhel" || "${ID:-}" == "centos" || "${ID_LIKE:-}" =~ fedora || "${ID_LIKE:-}" =~ rhel ]]; then
        echo "fedora"
    elif [[ "${ID:-}" == "debian" || "${ID:-}" == "ubuntu" || "${ID_LIKE:-}" =~ debian || "${ID_LIKE:-}" =~ ubuntu ]]; then
        echo "debian"
    elif [[ "${ID:-}" == "arch" || "${ID_LIKE:-}" =~ arch || "${ID:-}" == "cachyos" || "${ID_LIKE:-}" =~ cachyos ]] || [ -f /etc/arch-release ]; then
        echo "arch"
    elif [[ "${ID:-}" =~ opensuse || "${ID_LIKE:-}" =~ opensuse ]]; then
        echo "opensuse"
    elif [[ "${ID:-}" == "void" ]]; then
        echo "void"
    else
        echo "debian"
    fi
}

install_packages() {
    local packages="$1"
    local family="$2"
    local pkg

    for pkg in $packages; do
        case "$family" in
            fedora)
                sudo dnf install -y --setopt=install_weak_deps=False "$pkg" 2>/dev/null \
                    && echo -e "  ${GREEN}✓${NC} $pkg" \
                    || echo -e "  ${YELLOW}⊘${NC} $pkg (not found)"
                ;;
            debian)
                sudo apt-get install -y -m "$pkg" 2>/dev/null \
                    && echo -e "  ${GREEN}✓${NC} $pkg" \
                    || echo -e "  ${YELLOW}⊘${NC} $pkg (not found)"
                ;;
            arch)
                sudo pacman -S --noconfirm --needed "$pkg" 2>/dev/null \
                    && echo -e "  ${GREEN}✓${NC} $pkg" \
                    || echo -e "  ${YELLOW}⊘${NC} $pkg (not found)"
                ;;
            opensuse)
                sudo zypper install -y "$pkg" 2>/dev/null \
                    && echo -e "  ${GREEN}✓${NC} $pkg" \
                    || echo -e "  ${YELLOW}⊘${NC} $pkg (not found)"
                ;;
            void)
                sudo xbps-install -y "$pkg" 2>/dev/null \
                    && echo -e "  ${GREEN}✓${NC} $pkg" \
                    || echo -e "  ${YELLOW}⊘${NC} $pkg (not found)"
                ;;
        esac
    done
}

is_elf32() {
    local file="$1"
    local magic

    [ -s "$file" ] || return 1
    magic="$(od -An -N5 -tx1 "$file" 2>/dev/null | tr -d ' \n')"
    [ "$magic" = "7f454c4601" ]
}

find_slssteam_dir() {
    local candidates=(
        "$XDG_DATA_HOME/SLSsteam"
        "$FLATPAK_SLS_DIR"
    )
    local d

    for d in "${candidates[@]}"; do
        if [ -f "$d/SLSsteam.so" ]; then
            printf '%s' "$d"
            return 0
        fi
    done

    return 1
}

find_steam_sh() {
    local candidates=()
    local d

    if [ -d "$FLATPAK_STEAM_DIR" ]; then
        candidates+=("$FLATPAK_STEAM_DIR/steam.sh")
    fi
    candidates+=(
        "$HOME/.steam/steam/steam.sh"
        "$HOME/.local/share/Steam/steam.sh"
    )

    for d in "${candidates[@]}"; do
        if [ -f "$d" ]; then
            printf '%s' "$d"
            return 0
        fi
    done

    return 1
}

enable_cloud_in_config() {
    local cfg="$1"

    mkdir -p "$(dirname "$cfg")"
    if [ ! -s "$cfg" ]; then
        printf 'DisableCloud: no\n' > "$cfg"
        echo "  Cloud enabled: $cfg"
        return 0
    fi
    if grep -qE '^[[:space:]]*DisableCloud:' "$cfg"; then
        sed -i -E 's/^[[:space:]]*DisableCloud:.*/DisableCloud: no/' "$cfg"
    else
        printf '\n# Let SLSsteam expose cloud saves so CloudRedirect can take over\nDisableCloud: no\n' >> "$cfg"
    fi
    echo "  Cloud enabled: $cfg"
}

ensure_build_deps() {
    local family
    local missing=false

    command -v cmake >/dev/null 2>&1 || missing=true
    command -v g++ >/dev/null 2>&1 || missing=true
    if ! command -v ninja >/dev/null 2>&1 && ! command -v make >/dev/null 2>&1; then
        missing=true
    fi
    if ! command -v qmake6 >/dev/null 2>&1 \
        && [ ! -e /usr/lib/cmake/Qt6/Qt6Config.cmake ] \
        && [ ! -e /usr/lib64/cmake/Qt6/Qt6Config.cmake ] \
        && [ ! -e /usr/lib/x86_64-linux-gnu/cmake/Qt6/Qt6Config.cmake ]; then
        missing=true
    fi

    if [ "$missing" = false ]; then
        return 0
    fi

    family="$(detect_distro_family)"
    echo "Installing CloudRedirect GUI build dependencies ($family)..."

    case "$family" in
        fedora)
            install_packages "qt6-qtbase-devel qt6-qtdeclarative-devel qt6-qtdeclarative cmake ninja-build make gcc-c++" "$family"
            ;;
        debian)
            install_packages "qt6-base-dev qt6-declarative-dev qt6-base-dev-tools cmake ninja-build make g++ libgl1 qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-templates qml6-module-qtquick-layouts qml6-module-qtquick-window qml6-module-qtqml qml6-module-qtqml-workerscript qml6-module-qt-labs-platform" "$family"
            ;;
        arch)
            install_packages "qt6-base qt6-declarative cmake ninja make gcc" "$family"
            ;;
        opensuse)
            install_packages "qt6-base-devel qt6-declarative-devel cmake ninja make gcc-c++" "$family"
            ;;
        void)
            install_packages "qt6-base qt6-declarative cmake ninja make gcc" "$family"
            ;;
    esac

    command -v cmake >/dev/null 2>&1 || die "cmake not found. Install it and re-run ./cloudredirect"
    command -v g++ >/dev/null 2>&1 || die "g++ not found. Install it and re-run ./cloudredirect"
    if ! command -v qmake6 >/dev/null 2>&1 \
        && [ ! -e /usr/lib/cmake/Qt6/Qt6Config.cmake ] \
        && [ ! -e /usr/lib64/cmake/Qt6/Qt6Config.cmake ] \
        && [ ! -e /usr/lib/x86_64-linux-gnu/cmake/Qt6/Qt6Config.cmake ]; then
        die "Qt6 development files not found. Install qt6-base/qt6-declarative and re-run ./cloudredirect"
    fi
}

build_ui() {
    local so_sha="$1"
    local generator=() jobs build_dir

    if [ "$BUILD_UI" = false ]; then
        echo -e "${YELLOW}GUI build skipped (--no-ui)${NC}"
        return 0
    fi

    if [ "$FORCE_REBUILD" = false ] && [ -x "$CR_UI" ] && [ -f "$CR_STAMP" ] \
        && [ "$(cat "$CR_STAMP")" = "$so_sha" ]; then
        echo "GUI already up to date: $CR_UI"
        return 0
    fi

    if [ ! -d "$ASSETS/ui-linux" ]; then
        echo -e "${YELLOW}[WARN] Vendored UI source not found at $ASSETS/ui-linux - GUI not built.${NC}"
        return 0
    fi

    ensure_build_deps

    BUILD_SRC_DIR="$(mktemp -d)"
    CLEANUP_DIRS+=("$BUILD_SRC_DIR")

    if command -v ninja >/dev/null 2>&1; then
        generator=(-G Ninja)
    fi
    jobs="$(nproc 2>/dev/null || echo 2)"
    build_dir="$BUILD_SRC_DIR/build-ui"

    echo "Building native GUI (this can take a minute)..."
    if ! cmake -S "$ASSETS/ui-linux" -B "$build_dir" "${generator[@]}" -DCMAKE_BUILD_TYPE=Release >/dev/null 2>&1 \
        || ! cmake --build "$build_dir" -j"$jobs" >/dev/null 2>&1 \
        || [ ! -x "$build_dir/cloud-redirect-ui" ]; then
        echo -e "${YELLOW}[WARN] GUI build failed - .so and config were installed anyway.${NC}"
        echo "       Install qt6-base + qt6-declarative and re-run ./cloudredirect."
        return 0
    fi

    mkdir -p "$CR_DATA"
    cp -f "$build_dir/cloud-redirect-ui" "$CR_UI"
    chmod 755 "$CR_UI"
    printf '%s\n' "$so_sha" > "$CR_STAMP"
    echo -e "${GREEN}GUI installed: $CR_UI${NC}"
}

install_icons() {
    local sizes=(16 32 48 64 128 256 512)
    local size src

    for size in "${sizes[@]}"; do
        src="$ASSETS/icons/${size}x${size}/apps/cloudredirect.png"
        mkdir -p "$ICONS_DIR/${size}x${size}/apps"
        if [ -f "$src" ]; then
            cp -f "$src" "$ICONS_DIR/${size}x${size}/apps/cloudredirect.png"
        else
            rm -f "$ICONS_DIR/${size}x${size}/apps/cloudredirect.png"
        fi
    done
}

install_desktop_entry() {
    local desktop_file="$XDG_APPS_DIR/cloudredirect.desktop"

    if [ ! -x "$CR_UI" ]; then
        echo -e "${YELLOW}GUI not available - skipping .desktop launcher${NC}"
        return 0
    fi

    mkdir -p "$XDG_APPS_DIR"
    cat > "$desktop_file" <<EOF
[Desktop Entry]
Type=Application
Name=CloudRedirect
GenericName=Steam Cloud Redirecionador
Comment=Redireciona o Steam Cloud dos jogos SLSsteam para o provedor da sua escolha
Exec="$CR_UI"
Icon=cloudredirect
Terminal=false
Categories=Utility;Network;
Keywords=steam;cloud;slssteam;cloudredirect;
EOF
    chmod 644 "$desktop_file"
    update-desktop-database "$XDG_APPS_DIR" 2>/dev/null || true
    echo -e "${GREEN}Launcher installed: $desktop_file${NC}"
}

echo -e "${GREEN}=============================================="
echo "  CLOUDREDIRECT INSTALLER (cloudredirect-moon)"
echo "==============================================${NC}"
echo ""

SLS_DIR="$(find_slssteam_dir)" || die "SLSsteam not found. Run ./enter-the-wired first."
STEAM_SH="$(find_steam_sh)" || die "steam.sh not found. Install Steam and run ./enter-the-wired first."
echo "SLSsteam:  $SLS_DIR"
echo "steam.sh:  $STEAM_SH"
echo ""

resolve_assets_dir
echo ""

echo "Staging CloudRedirect binaries from vendored assets..."
mkdir -p "$CR_STAGE"
cp -f "$ASSETS/cloud_redirect.so" "$CR_STAGE/cloud_redirect.so"
cp -f "$ASSETS/cloud_redirect_cli" "$CR_STAGE/cloud_redirect_cli"
chmod 755 "$CR_STAGE/cloud_redirect.so" "$CR_STAGE/cloud_redirect_cli"

is_elf32 "$CR_STAGE/cloud_redirect.so" || die "cloud_redirect.so is not a 32-bit ELF (bad download)"
is_elf32 "$CR_STAGE/cloud_redirect_cli" || die "cloud_redirect_cli is not a 32-bit ELF (bad download)"
SO_SHA="$(sha256sum "$CR_STAGE/cloud_redirect.so" | awk '{print $1}')"
echo "cloud_redirect.so sha256: $SO_SHA"
echo ""

echo "Deploying CloudRedirect..."
mkdir -p "$CR_DATA"
cp -f "$CR_STAGE/cloud_redirect.so" "$CR_DATA/cloud_redirect.so"
cp -f "$CR_STAGE/cloud_redirect_cli" "$CR_DATA/cloud_redirect_cli"
chmod 755 "$CR_DATA/cloud_redirect.so" "$CR_DATA/cloud_redirect_cli"
echo "  Deployed to: $CR_DATA"

if [ -d "$FLATPAK_SLS_DIR" ] || [ -d "$FLATPAK_STEAM_DIR" ]; then
    mkdir -p "$FLATPAK_CR_DATA"
    cp -f "$CR_STAGE/cloud_redirect.so" "$FLATPAK_CR_DATA/cloud_redirect.so"
    cp -f "$CR_STAGE/cloud_redirect_cli" "$FLATPAK_CR_DATA/cloud_redirect_cli"
    chmod 755 "$FLATPAK_CR_DATA/cloud_redirect.so" "$FLATPAK_CR_DATA/cloud_redirect_cli"
    echo "  Deployed to: $FLATPAK_CR_DATA"
fi
echo ""

echo "Enabling Steam Cloud in SLSsteam config..."
enable_cloud_in_config "$XDG_CONFIG_HOME/SLSsteam/config.yaml"
if [ -d "$FLATPAK_SLS_CONFIG_DIR" ] || [ -d "$FLATPAK_SLS_DIR" ] || [ -d "$FLATPAK_STEAM_DIR" ]; then
    enable_cloud_in_config "$FLATPAK_SLS_CONFIG_DIR/config.yaml"
fi
echo ""

if grep -q "cloud_redirect" "$STEAM_SH" 2>/dev/null; then
    echo "steam.sh already loads CloudRedirect: $STEAM_SH"
else
    echo "Patching steam.sh with the CloudRedirect loader..."
    CR_SH_SRC="$ASSETS/headcrab_native.sh"
    EXPECTED_CLIENT="$HOME/.steam/steam/client.sh"
    if [ -d "$FLATPAK_STEAM_DIR" ]; then
        CR_SH_SRC="$ASSETS/headcrab_flatpak.sh"
        EXPECTED_CLIENT="$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/client.sh"
    fi
    if [ ! -f "$CR_SH_SRC" ]; then
        die "vendored loader missing: $CR_SH_SRC"
    fi

    mkdir -p "$(dirname "$EXPECTED_CLIENT")"
    if [ ! -f "$EXPECTED_CLIENT" ]; then
        echo "Saving the stock Steam client script to $EXPECTED_CLIENT..."
        if [ ! -f "$ASSETS/client.sh" ]; then
            die "vendored stock steam.sh missing: $ASSETS/client.sh"
        fi
        cp -f "$ASSETS/client.sh" "$EXPECTED_CLIENT"
        chmod 755 "$EXPECTED_CLIENT"
    fi

    if [ ! -f "$STEAM_SH.etw-bak" ]; then
        cp -f "$STEAM_SH" "$STEAM_SH.etw-bak"
    fi
    chmod u+w "$STEAM_SH" 2>/dev/null || sudo chmod u+w "$STEAM_SH"
    cp -f "$CR_SH_SRC" "$STEAM_SH" || die "could not install the CloudRedirect steam.sh"
    chmod 555 "$STEAM_SH" 2>/dev/null || sudo chmod 555 "$STEAM_SH"
    echo "  Patched: $STEAM_SH (backup at $STEAM_SH.etw-bak)"
fi
echo ""

build_ui "$SO_SHA"
echo ""

install_icons
install_desktop_entry
echo ""

echo "=============================================="
echo -e "${GREEN}  CLOUDREDIRECT READY${NC}"
echo "=============================================="
echo ""
echo "  .so:       $CR_DATA/cloud_redirect.so"
echo "  CLI:       $CR_DATA/cloud_redirect_cli"
if [ -x "$CR_UI" ]; then
    echo "  GUI:       $CR_UI"
    echo "  Menu:      CloudRedirect (app launcher)"
fi
echo ""
echo "  1. Open the CloudRedirect GUI and sign in to your cloud provider."
echo "  2. Add the games you want to sync under AdditionalApps in"
echo "     $XDG_CONFIG_HOME/SLSsteam/config.yaml"
echo "  3. Restart Steam and watch your saves sync."
echo ""
echo "  Upstream: Selectively11/CloudRedirect - this install uses the"
echo "  swwayps/cloudredirect-moon fork (cross-distro attach fixes,"
echo "  legacy save-layout healing, worker-thread crash containment)."
