#!/usr/bin/env bash
set -euo pipefail

# ENTER THE WIRED
# "I am here. But where is here? And where is here within here?"

# Combo script that installs ACCELA, SLSsteam and CloudRedirect
# Supports both local and curl | bash execution

GITHUB_USER="LucianoSkx"
GITHUB_REPO="enter-the-wired"

# Repository archive - single self-hosted fetch that carries the scripts and
# the vendored assets (headcrab.sh + CloudRedirect stack).
REPO_TARBALL_URL="https://codeload.github.com/$GITHUB_USER/$GITHUB_REPO/tar.gz/refs/heads/main"

# Detect if running via curl | bash (BASH_SOURCE empty or BASH_SOURCE[0] == "-")
RUNNING_VIA_PIPE=false
if [ -z "${BASH_SOURCE:-}" ] || [ ${#BASH_SOURCE[@]} -eq 0 ] || [[ "${BASH_SOURCE[0]:-}" == "-" ]]; then
    RUNNING_VIA_PIPE=true
fi

# Colors (disabled if not interactive terminal)
if [ -t 1 ] && [ -t 0 ]; then
    GREEN='\033[0;32m'
    RED='\033[0;31m'
    YELLOW='\033[1;33m'
    NC='\033[0m'
else
    GREEN=''
    RED=''
    YELLOW=''
    NC=''
fi

# Helper: best-effort detection of SLSsteam install directory. Returns
# a sensible path if found, otherwise prints "unknown".
get_sls_install_dir() {
    # Common candidate locations (checked in order)
    local candidates=(
        "$HOME/.local/share/SLSsteam"
        "$HOME/.var/app/com.valvesoftware.Steam/.local/share/SLSsteam"
    )

    for d in "${candidates[@]}"; do
        if [ -d "${d}" ]; then
            printf '%s' "${d}"
            return 0
        fi
    done

    printf 'unknown'
}

if [ "$RUNNING_VIA_PIPE" = true ]; then
    # Running via curl | bash - fetch the repository archive (scripts + vendor)
    echo -e "${GREEN}Detected pipe execution, fetching repository archive...${NC}"

    TMP_ROOT=$(mktemp -d)
    trap "rm -rf $TMP_ROOT" EXIT

    curl -fsSL --retry 3 --retry-delay 2 -H "Cache-Control: no-cache" \
        -o "$TMP_ROOT/repo.tar.gz" "$REPO_TARBALL_URL"
    tar -xzf "$TMP_ROOT/repo.tar.gz" -C "$TMP_ROOT"
    SCRIPT_DIR="$TMP_ROOT/enter-the-wired-main"

    chmod +x "$SCRIPT_DIR/accela" "$SCRIPT_DIR/fix-deps" "$SCRIPT_DIR/cloudredirect"

    # Defer Headcrab execution until after other components are installed so
    # it runs as the final step and only once.
    echo -e "${GREEN}Deferring Headcrab execution until after installations...${NC}"
else
    # Local execution - source from same directory
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    if [ ! -f "$SCRIPT_DIR/accela" ]; then
        echo "Error: accela not found in $SCRIPT_DIR"
        exit 1
    fi
    if [ ! -f "$SCRIPT_DIR/fix-deps" ]; then
        echo "Error: fix-deps not found in $SCRIPT_DIR"
        exit 1
    fi
    if [ ! -f "$SCRIPT_DIR/cloudredirect" ]; then
        echo "Error: cloudredirect not found in $SCRIPT_DIR"
        exit 1
    fi
fi

if [ ! -f "$SCRIPT_DIR/vendor/headcrab.sh" ]; then
    echo "Error: vendor/headcrab.sh not found in $SCRIPT_DIR"
    exit 1
fi

echo -e "${GREEN}=============================================="
echo "  ENTER THE WIRED - Combo Installer"
echo "==============================================${NC}"
echo ""

# Run fix-deps first to ensure all dependencies are installed
# Skip on Bazzite (read-only /usr, dependencies already handled by rpm-ostree)
echo "Installing dependencies..."
echo "----------------------------------------------"
if [ -f /etc/os-release ]; then
    source /etc/os-release
    if [ "$ID" = "bazzite" ] || [ "$ID" = "steamos" ]; then
        echo "  $ID detected - skipping fix-deps (handled by ostree/package manager)"
    else
        source "$SCRIPT_DIR/fix-deps"
    fi
else
    source "$SCRIPT_DIR/fix-deps"
fi
echo ""

echo "If you have issues with missing dependencies, run:"
echo "  ./fix-deps"

echo ""
echo "=============================================="
echo -e "${GREEN}  INSTALLING COMPONENTS${NC}"
echo "=============================================="
echo ""

# Source accela (local helper). Run Headcrab (remote SLSsteam) in a subshell to
# keep the installer's shell isolated from the remote script's environment.
source "$SCRIPT_DIR/accela"

# Execute the vendored Headcrab (SLSsteam) in a subshell to keep the
# installer's shell isolated from the script's environment.
(
    bash "$SCRIPT_DIR/vendor/headcrab.sh" "$@"
)

# CloudRedirect (cloudredirect-moon): .so + steam.sh loader + native GUI.
# Non-fatal so a GUI build failure never undoes the rest of the install.
echo ""
echo "Installing CloudRedirect..."
echo "----------------------------------------------"
if ! bash "$SCRIPT_DIR/cloudredirect"; then
    echo -e "${YELLOW}CloudRedirect did not finish. Re-run it later with:${NC}"
    echo "  ~/enter-the-wired/cloudredirect"
fi

echo ""
echo "=============================================="
echo -e "${GREEN}  ALL INSTALLATIONS COMPLETED!${NC}"
echo "=============================================="
echo ""
echo "  ACCELA:        Installed at ~/.local/share/ACCELA"
echo "  SLSsteam:      Installed at $(get_sls_install_dir)"
echo "  CloudRedirect: Installed at ~/.local/share/CloudRedirect"
echo "  Scripts:       Saved at ~/enter-the-wired"
echo "  Open the CloudRedirect app to pick your cloud provider,"
echo "  then restart Steam."
echo ""

# Copy scripts and the vendored assets to ~/enter-the-wired for future use
echo "Saving scripts to ~/enter-the-wired..."
echo "----------------------------------------------"

ENTER_THE_WIRED_DIR="$HOME/enter-the-wired"
mkdir -p "$ENTER_THE_WIRED_DIR"

save_script() {
    cp -f "$SCRIPT_DIR/$1" "$ENTER_THE_WIRED_DIR/$1"
}

save_script accela
save_script fix-deps
save_script cloudredirect
save_script uninstall
rm -rf "$ENTER_THE_WIRED_DIR/vendor"
cp -r "$SCRIPT_DIR/vendor" "$ENTER_THE_WIRED_DIR/vendor"
cat > "$ENTER_THE_WIRED_DIR/slssteam" << 'EOF'
#!/usr/bin/env bash
# Wrapper: run the vendored Headcrab (SLSsteam) installer
exec bash "$HOME/enter-the-wired/vendor/headcrab.sh" "$@"
EOF

# Set execute permissions (ignore if files don't exist)
chmod +x "$ENTER_THE_WIRED_DIR/accela" 2>/dev/null || true
chmod +x "$ENTER_THE_WIRED_DIR/slssteam" 2>/dev/null || true
chmod +x "$ENTER_THE_WIRED_DIR/fix-deps" 2>/dev/null || true
chmod +x "$ENTER_THE_WIRED_DIR/cloudredirect" 2>/dev/null || true
chmod +x "$ENTER_THE_WIRED_DIR/uninstall" 2>/dev/null || true
chmod +x "$ENTER_THE_WIRED_DIR/vendor/headcrab.sh" 2>/dev/null || true

echo -e "${GREEN}Scripts saved to $ENTER_THE_WIRED_DIR${NC}"
echo ""
echo "=============================================="
echo -e "${YELLOW}  WHAT WAS INSTALLED${NC}"
echo "=============================================="
echo ""
echo "  ACCELA        - Installed at ~/.local/share/ACCELA"
echo "  SLSsteam      - Patched Steam for Linux Runtime"
echo "  CloudRedirect - Steam Cloud for lua games (cloudredirect-moon)"
echo ""
echo "=============================================="
echo -e "${YELLOW}  LOCAL SCRIPTS AVAILABLE${NC}"
echo "=============================================="
echo ""
echo "  ~/enter-the-wired/accela        - Install/upgrade ACCELA"
echo "  ~/enter-the-wired/slssteam      - Install Steam Linux Runtime"
echo "  ~/enter-the-wired/cloudredirect - Install/repair CloudRedirect"
echo "  ~/enter-the-wired/fix-deps      - Fix missing system dependencies"
echo "  ~/enter-the-wired/uninstall     - Remove all installations"
echo ""
echo "  If you have missing dependencies or ran into issues trying to use ACCELA or SLSsteam, run:"
echo "  ~/enter-the-wired/fix-deps"
echo ""
echo "Protocol complete. Welcome to the Wired."
